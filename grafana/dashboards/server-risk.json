{
  "uid": "server-risk",
  "title": "Sentinel | Server Early Warning",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 8,
      "type": "text",
      "title": "Experiment context",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**SENTINEL \u00b7 EARLY WARNING** | 2s samples \u00b7 Demo: 30s trend / 25s forecast \u00b7 Linux: 5m trend / 10m forecast\n\nThe forecast predicts disk capacity exhaustion. Isolation Forest detects unusual windows independently. Demo disk: dedicated **24 MiB tmpfs**. Linux profile: host **root filesystem**. Default ML model is **synthetic**; calibrate with normal data from the monitored host."
      }
    },
    {
      "id": 1,
      "title": "Disk forecast alert",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ALERTS{alertname=\"DiskPredictedToFill\",alertstate=\"firing\"}) or (max(server_data_fresh)*0)",
          "legendFormat": "Disk forecast alert",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Clear",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Firing",
                  "color": "orange",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "title": "ML inference ready",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "server_model_ready and on(instance,job) server_data_fresh",
          "legendFormat": "ML baseline",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Training",
                  "color": "yellow",
                  "index": 0
                },
                "1": {
                  "text": "Ready",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "title": "Metrics exporter",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"server\"}",
          "legendFormat": "Metrics exporter",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 4,
      "title": "Disk usage and forecast",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "server_disk_usage_percent",
          "legendFormat": "Actual",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "server_disk_predicted_usage_percent",
          "legendFormat": "Projected usage (configured horizon)",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "expr": "95 + 0 * server_disk_usage_percent",
          "legendFormat": "95% demo limit",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "CPU and memory usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "server_cpu_usage_percent",
          "legendFormat": "CPU",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "server_memory_usage_percent",
          "legendFormat": "Memory",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "ML anomaly score",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "server_anomaly_score and (server_model_ready == 1)",
          "legendFormat": "Score",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "0 * (server_model_ready == 1)",
          "legendFormat": "Anomaly threshold",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Positive means anomalous; not a failure probability. Default model trained on synthetic demo data. Retrain on your host before interpreting real anomaly rates.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Alert history",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertname=\"DiskPredictedToFill\",alertstate=\"firing\"}) or sum(up{job=\"server\"} == 1) * 0",
          "legendFormat": "Predictive alert",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(ALERTS{alertname=\"DiskUsageHigh\",alertstate=\"firing\"}) or sum(up{job=\"server\"} == 1) * 0",
          "legendFormat": "90% baseline alert",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "description": "CPU, memory, disk forecasts and independent anomaly detection. Demo window: 25s; training fixture is synthetic.",
  "tags": [
    "sentinel",
    "devops",
    "early-warning"
  ],
  "links": [
    {
      "title": "Prometheus alerts",
      "type": "link",
      "url": "http://localhost:9090/alerts",
      "targetBlank": true
    },
    {
      "title": "Alertmanager",
      "type": "link",
      "url": "http://localhost:9093",
      "targetBlank": true
    },
    {
      "title": "Service API",
      "type": "link",
      "url": "http://localhost:8001/docs",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Firing alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "iconColor": "orange",
        "step": "2s",
        "tagKeys": "alertname,severity"
      }
    ]
  }
}
